# 이 파일을 .env 로 복사한 뒤 값을 채우면 npm start 가 알아서 읽는다.
# .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않는다.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)

# ---------------------------------------------------------------- 기본

# 로그인 리디렉트 주소의 기준. 배포하면 실제 주소로 바꾼다.
BASE_URL=http://localhost:3000

# 랭킹 관리 화면(/admin.html) 열쇠.
# 비워 두면 서버가 만들어 data/admin-token.txt 에 저장한다.
# ADMIN_TOKEN=

# 게임 안에서 관리 버튼(🛠)을 볼 계정.
#
# 이 계정으로 로그인하면 상단 바에 관리 버튼이 생기고, 열쇠 없이
# 기록 삭제와 전적 초기화를 할 수 있다. 여러 명이면 쉼표로 나눈다.
#
# 둘 중 하나만 채우면 된다.
#   ADMIN_NICKNAMES  쉽다. 대신 닉네임을 바꾸면 관리자에서 풀린다.
#   ADMIN_USER_IDS   안전하다. 닉네임을 바꿔도 유지된다.
#                    id 는 /admin.html 의 계정 목록에서 확인한다.
ADMIN_NICKNAMES=
# ADMIN_USER_IDS=

# ---------------------------------------------------------------- Google 로그인

# https://console.cloud.google.com 에서 발급 (무료)
#   API 및 서비스 > 사용자 인증 정보 > 사용자 인증 정보 만들기 > OAuth 클라이언트 ID
#   유형: 웹 애플리케이션
#   승인된 리디렉션 URI: http://localhost:3000/auth/google/callback
#
# 둘 다 채워야 로그인 버튼이 나타난다. 비워 두면 게스트로만 논다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Apple 로그인

# Apple Developer Program (연 $99) 이 필요하고, HTTPS 도메인에서만 동작한다.
# localhost 로는 시험할 수 없으므로 배포한 뒤에 채운다.
#
# APPLE_CLIENT_ID=      Services ID (예: com.example.avoidarc.web)
# APPLE_TEAM_ID=        개발자 계정의 Team ID
# APPLE_KEY_ID=         Sign in with Apple 용 키의 Key ID
# APPLE_PRIVATE_KEY=    .p8 파일 내용. 줄바꿈은 \n 으로 바꿔 한 줄로 넣는다
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
